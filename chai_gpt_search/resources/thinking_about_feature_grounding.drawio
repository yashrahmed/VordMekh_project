          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="260" y="375" />
              <mxPoint x="260" y="400" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="0hWZ1rmW96yIc9XrhgOy-26" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="What is the technique for making the vegetables look like matchsticks?" vertex="1">
